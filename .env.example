# Copy to .env on the host. This is the image the lumo_box runs — not the git branch.
#
# Preview (CI on `dev`):
# BOX_IMAGE=ghcr.io/banter240/lumo-box:dev
#
# Pinned release (what you want on a server):
# BOX_IMAGE=ghcr.io/banter240/lumo-box:0.7.0
#
# Moving stable (only if you accept "whatever main last published"):
# BOX_IMAGE=ghcr.io/banter240/lumo-box:latest

BOX_IMAGE=ghcr.io/banter240/lumo-box:dev
